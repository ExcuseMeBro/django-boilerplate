# Django
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
# Secure/HttpOnly cookies. Defaults to "not DEBUG"; only override to debug over plain HTTP.
SECURE_COOKIES=
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
ENABLE_HTTPS_REDIRECT=False
TZ=Asia/Tashkent
BACKEND_URL=http://localhost:8000
SECURE_HSTS_SECONDS=31536000

# PostgreSQL
DB_NAME=unfold_boilerplate_db
DB_USER=unfold_user
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
# Use `require` (or verify-full) for any Postgres you do not control the network to.
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Redis / Channels
REDIS_URL=redis://redis:6379/0

# API throttling
DRF_THROTTLE_ANON=100/hour
DRF_THROTTLE_USER=1000/hour
DRF_THROTTLE_OTP=5/minute

# Upload limits
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
AVATAR_MAX_BYTES=2097152
AVATAR_MAX_DIMENSION=4096

# JWT / OTP
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30
OTP_LENGTH=6
# Fixed OTP for local development. MUST stay empty unless DEBUG=True — the app
# refuses to boot with a static code in production. Empty = random code every time.
OTP_STATIC_CODE=
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_DAILY_PER_PHONE=5
OTP_MAX_VERIFY_ATTEMPTS=3
# `console` logs the code only when DEBUG=True. Wire a real provider for production.
SMS_BACKEND=console

# MinIO S3-compatible media storage
USE_MINIO=True
FORCE_MINIO_IN_DEBUG=True
# Presigned URLs are signed for MINIO_ENDPOINT, so the backend and the browser must
# reach MinIO at the same host. For local dev add `127.0.0.1 minio` to /etc/hosts.
MINIO_ENDPOINT=minio:9000
MINIO_INTERNAL_ENDPOINT=minio:9000
# Leave False: the bucket is private and media is served via expiring signed URLs.
MINIO_PUBLIC_READ=False
MINIO_URL_EXPIRY_SECONDS=3600
MINIO_USE_HTTPS=False
MINIO_INTERNAL_USE_HTTPS=False
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=unfold-boilerplate
MINIO_REGION=us-east-1

# Firebase optional
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_BASE64=
FCM_SERVER_KEY=
